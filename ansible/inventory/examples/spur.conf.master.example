# Example master spur.conf — this file itself is the Ansible inventory source
# for every playbook (see inventory_plugins/spur_conf.py):
#   ansible-playbook -i spur.conf.master.example playbooks/deploy.yml
#
# Everything below [ansible] is the real spur.conf schema (see
# ansible/roles/spur_controller/templates/spur.conf.j2). The [ansible] table,
# [[ansible_login_nodes]], [[ansible_accounting_nodes]], [[ansible_controllers]],
# and any ansible_* keys on [[nodes]]/[[ansible_controllers]] entries are
# ansible-only metadata, stripped before this file is ever pushed to a node.

cluster_name = "example-cluster"

[ansible]
default_user = "vm"
# Sections listed here are never pushed by ansible; whatever's already on the
# node for these sections is left exactly as-is. Use this for anything you
# want to manage by hand outside of this file.
exclude_sections = ["accounting"]

[controller]
listen_addr = "[::]:6817"
hosts = ["10.11.98.147"]
state_dir = "/opt/spur/state"
raft_listen_addr = "[::]:6821"

[scheduler]
plugin = "backfill"
interval_secs = 1

[accounting]
database_url = "postgresql://spur:spur@10.11.98.147:5432/spur"
fairshare_refresh_secs = 30

[network]
wg_enabled = false
agent_port = 6818

# cpus/memory_mb are optional — if omitted, ansible fills them in from the
# node's live gathered facts (ansible_processor_vcpus/ansible_memtotal_mb) the
# first time it's pushed to. An explicit value here always wins.
[[nodes]]
names = "gpu-1"
ansible_host = "10.11.71.210"
ansible_user = "vm"

[[partitions]]
name = "default"
default = true
nodes = "gpu-1"
max_time = "INFINITE"

# Optional — login/submission nodes (CLI only, no daemon). Omit entirely if none.
# [[ansible_login_nodes]]
# name = "login1"
# ansible_host = "10.0.0.20"
# ansible_user = "vm"

# Optional — a dedicated (non-controller/non-agent) Postgres host for
# accounting. Omit entirely to co-locate accounting on the first controller.
# [[ansible_accounting_nodes]]
# name = "db1"
# ansible_host = "10.0.0.30"
# ansible_user = "vm"
