# 20-node HA Spur cluster over a WireGuard mesh, running a SPUR-managed k0s
# (k8s) cluster with an HA control plane. Plus 1 login node (21 hosts total).
#
# Node roll-up (20 + 1 login):
#   3   SPUR controllers (spurctld / Raft quorum)   -> ctl-0,1,2
#   3   k0s control-plane nodes (HA etcd quorum)    -> k8s-cp-0,1,2
#   5   k0s worker nodes                            -> k8s-w-0..4
#   9   plain compute agents (no k8s)               -> gpu-0..8
#   1   login-only node                             -> login-0
#
# IMPORTANT — how k8s roles map here: there is no separate k8s inventory
# concept. The k0s control-plane-vs-worker split is a RUNTIME parameter passed
# to `spur k8s up` via spur_k8s_control_plane_nodes / spur_k8s_nodes (both
# ansible -e vars, see the command below) — every k8s node must first be a
# registered SPUR agent ([[nodes]] entry), same as k8s-cp-*/k8s-w-* here. The
# k0s control plane is an independent quorum from the spurctld controllers —
# different hosts in this example.
#
# Quorum math (tolerate floor((N-1)/2) failures):
#   3 SPUR controllers  -> tolerate 1 spurctld failure
#   3 k0s control-plane -> tolerate 1 etcd failure
#
# Mesh addressing: pinned per host with ansible_wg_address (recommended — the
# role's positional auto-assign is NOT stable once you add/remove nodes). A
# block of the /16 is reserved per role so the layout stays readable as the
# cluster grows: ctl-* -> .1-3, k8s-cp-* -> .11-13, k8s-w-* -> .21-25,
# gpu-* -> .31-39, login-0 -> .41.
#
#   Deploy: ansible-playbook playbooks/deploy.yml -i spur.conf.k8s-ha.example \
#             -e spur_transport=wireguard -e spur_k8s_enabled=true \
#             -e spur_k8s_cni=calico \
#             -e spur_k8s_control_plane_nodes=k8s-cp-0,k8s-cp-1,k8s-cp-2 \
#             -e spur_k8s_nodes=k8s-cp-0,k8s-cp-1,k8s-cp-2,k8s-w-0,k8s-w-1,k8s-w-2,k8s-w-3,k8s-w-4
#   k8s up: ansible-playbook playbooks/k8s_up.yml -i spur.conf.k8s-ha.example \
#             -e spur_k8s_control_plane_nodes=k8s-cp-0,k8s-cp-1,k8s-cp-2 \
#             -e spur_k8s_nodes=k8s-cp-0,k8s-cp-1,k8s-cp-2,k8s-w-0,k8s-w-1,k8s-w-2,k8s-w-3,k8s-w-4
#
# spur_transport/spur_k8s_* are ansible-side variables (gate which roles run),
# kept as -e flags rather than file content since they're deploy-time choices,
# not runtime daemon config (spur.conf's own [cluster] section, which the
# controller pushes once spur_k8s_enabled=true, IS daemon config and is
# populated automatically — no need to hand-author it here).
#
# Copy this to a real file and fill in your hosts/credentials.

cluster_name = "k8s-ha-cluster"

[ansible]
default_user = "root"
exclude_sections = []

[controller]
listen_addr = "[::]:6817"
hosts = ["10.44.0.1", "10.44.0.2", "10.44.0.3"]
state_dir = "/opt/spur/state"
raft_listen_addr = "[::]:6821"

[scheduler]
plugin = "backfill"
interval_secs = 1

[network]
wg_enabled = true
wg_interface = "spur0"
wg_cidr = "10.44.0.0/16"
wg_port = 51820
agent_port = 6818

# Every controller also runs spurd so it registers as a node and stays in the
# mesh membership (a mesh member that never registers is pruned from every peer).
[[nodes]]
names = "ctl-0"
ansible_host = "10.0.0.10"
ansible_wg_address = "10.44.0.1"

[[nodes]]
names = "ctl-1"
ansible_host = "10.0.0.11"
ansible_wg_address = "10.44.0.2"

[[nodes]]
names = "ctl-2"
ansible_host = "10.0.0.12"
ansible_wg_address = "10.44.0.3"

# k0s HA control-plane nodes (also plain SPUR agents):
[[nodes]]
names = "k8s-cp-0"
ansible_host = "10.0.0.20"
ansible_wg_address = "10.44.0.11"

[[nodes]]
names = "k8s-cp-1"
ansible_host = "10.0.0.21"
ansible_wg_address = "10.44.0.12"

[[nodes]]
names = "k8s-cp-2"
ansible_host = "10.0.0.22"
ansible_wg_address = "10.44.0.13"

# k0s worker nodes:
[[nodes]]
names = "k8s-w-0"
ansible_host = "10.0.0.30"
ansible_wg_address = "10.44.0.21"

[[nodes]]
names = "k8s-w-1"
ansible_host = "10.0.0.31"
ansible_wg_address = "10.44.0.22"

[[nodes]]
names = "k8s-w-2"
ansible_host = "10.0.0.32"
ansible_wg_address = "10.44.0.23"

[[nodes]]
names = "k8s-w-3"
ansible_host = "10.0.0.33"
ansible_wg_address = "10.44.0.24"

[[nodes]]
names = "k8s-w-4"
ansible_host = "10.0.0.34"
ansible_wg_address = "10.44.0.25"

# Plain compute agents (in the mesh + SPUR scheduler, NOT part of the k0s cluster):
[[nodes]]
names = "gpu-0"
ansible_host = "10.0.0.40"
ansible_wg_address = "10.44.0.31"

[[nodes]]
names = "gpu-1"
ansible_host = "10.0.0.41"
ansible_wg_address = "10.44.0.32"

[[nodes]]
names = "gpu-2"
ansible_host = "10.0.0.42"
ansible_wg_address = "10.44.0.33"

[[nodes]]
names = "gpu-3"
ansible_host = "10.0.0.43"
ansible_wg_address = "10.44.0.34"

[[nodes]]
names = "gpu-4"
ansible_host = "10.0.0.44"
ansible_wg_address = "10.44.0.35"

[[nodes]]
names = "gpu-5"
ansible_host = "10.0.0.45"
ansible_wg_address = "10.44.0.36"

[[nodes]]
names = "gpu-6"
ansible_host = "10.0.0.46"
ansible_wg_address = "10.44.0.37"

[[nodes]]
names = "gpu-7"
ansible_host = "10.0.0.47"
ansible_wg_address = "10.44.0.38"

[[nodes]]
names = "gpu-8"
ansible_host = "10.0.0.48"
ansible_wg_address = "10.44.0.39"

[[partitions]]
name = "default"
default = true
nodes = "ctl-0,ctl-1,ctl-2,k8s-cp-0,k8s-cp-1,k8s-cp-2,k8s-w-0,k8s-w-1,k8s-w-2,k8s-w-3,k8s-w-4,gpu-0,gpu-1,gpu-2,gpu-3,gpu-4,gpu-5,gpu-6,gpu-7,gpu-8"
max_time = "INFINITE"

# Login-only node (in the mesh so interactive srun streams job output over the
# tunnel); not a controller/agent, not a k8s node.
[[ansible_login_nodes]]
name = "login-0"
ansible_host = "10.0.0.50"
ansible_wg_address = "10.44.0.41"
