# Real inventories contain host IPs and credentials — never commit them.
# Only the *.example.ini templates (placeholder addresses) are tracked.
inventory/*.ini
!inventory/*.example.ini

# Ansible runtime artifacts
*.retry

# Native-auth JWKS key sets fetched to the control node (spur_auth_keys_dir).
# These files ARE the cluster's auth secrets (auth.jwks is a shared HMAC key) —
# never commit them.
keys/
