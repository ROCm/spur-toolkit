[Unit]
Description=Spur Controller Daemon (spurctld)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HOME={{ spur_home }}
{% if spur_auth_enabled | default(false) | bool %}
# Native auth: verify user creds (auth.jwks) and sign controller/cred/node tokens.
# Set explicitly from spur_auth_key_dir so the keys can live outside the built-in
# /etc/spur default — e.g. a shared NFS mount. Defaults to /etc/spur/*.jwks.
Environment=SPUR_AUTH_JWKS={{ spur_auth_key_dir }}/auth.jwks
Environment=SPUR_CONTROLLER_SIGNING_JWKS={{ spur_auth_key_dir }}/controller-signing.jwks
Environment=SPUR_CRED_SIGNING_JWKS={{ spur_auth_key_dir }}/cred-signing.jwks
Environment=SPUR_NODE_SIGNING_JWKS={{ spur_auth_key_dir }}/node-signing.jwks
{% endif %}
WorkingDirectory={{ spur_home }}
ExecStart={{ spur_install_dir }}/spurctld -f {{ spur_home }}/etc/spur.conf --state-dir {{ spur_home }}/state --log-level {{ spur_log_level }}
Restart=on-failure
RestartSec=3
# spurctld has no bounded timeout of its own around draining an active srun step
# on shutdown (SPUR-304) — it can block SIGTERM handling for as long as that step
# runs. Without this, systemd's own default TimeoutStopSec (~90s) is what finally
# kills it, stalling every stop/restart/rolling-upgrade behind a live job. Bound it
# here instead so a stuck shutdown gets SIGKILL'd quickly.
TimeoutStopSec={{ spur_controller_stop_timeout_secs | default(15) }}
User=root
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
