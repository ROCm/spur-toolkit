{#
  Day-0 bootstrap template ONLY — invoked once by playbooks/bootstrap_conf.yml
  to hand a first-time operator a starter spur.conf. Every other playbook
  reads/pushes an existing spur.conf via the spur_conf inventory plugin +
  spur_conf_for_push filter instead of rendering this on every run.
#}
cluster_name = "{{ spur_cluster_name }}"

[ansible]
default_user = "{{ spur_bootstrap_ansible_user }}"
exclude_sections = []

[controller]
listen_addr = "[::]:{{ spur_controller_port }}"
hosts = [{% for h in groups['spur_controllers'] %}"{{ hostvars[h]['ansible_host'] | default(hostvars[h]['ansible_default_ipv4']['address']) }}"{% if not loop.last %}, {% endif %}{% endfor %}]
state_dir = "{{ spur_home }}/state"
raft_listen_addr = "[::]:{{ spur_raft_port }}"
{% if spur_ha_enabled %}
peers = [{% for h in groups['spur_controllers'] %}"{{ hostvars[h]['ansible_host'] | default(hostvars[h]['ansible_default_ipv4']['address']) }}:{{ spur_raft_port }}"{% if not loop.last %}, {% endif %}{% endfor %}]
{% endif %}

[scheduler]
plugin = "backfill"
interval_secs = 1

{% if spur_accounting_enabled | default(true) | bool %}
[accounting]
# Fill in the real Postgres host/creds before using this file for real —
# bootstrap defaults to the first controller, co-located.
database_url = "postgresql://{{ spur_accounting_db_user | default('spur') }}:{{ spur_accounting_db_password | default('spur') }}@{{ hostvars[groups['spur_controllers'][0]]['ansible_host'] | default(hostvars[groups['spur_controllers'][0]]['ansible_default_ipv4']['address']) }}:{{ spur_accounting_db_port | default(5432) }}/{{ spur_accounting_db_name | default('spur') }}"
fairshare_refresh_secs = 30
{% endif %}

[network]
wg_enabled = {{ (spur_transport == 'wireguard') | string | lower }}
{% if spur_transport == 'wireguard' %}
wg_interface = "{{ spur_wg_interface }}"
wg_cidr = "{{ spur_wg_cidr }}"
wg_port = {{ spur_wg_port }}
{% endif %}
agent_port = {{ spur_agent_port }}

{% if spur_k8s_enabled | default(false) | bool %}
{% set _k8s_cp_list = spur_k8s_control_plane_nodes | default('') | split(',') | map('trim') | select | list %}
[cluster]
enabled = true
distro = "k0s"
pod_cidr = "{{ spur_k8s_pod_cidr }}"
service_cidr = "{{ spur_k8s_service_cidr }}"
cni = "{{ spur_k8s_cni }}"
cni_mtu = {{ spur_k8s_cni_mtu }}
{% if _k8s_cp_list | length > 0 %}
{# spurctld's k0s control plane: bootstrap = first entry, replicas = count (1/3/5). #}
control_plane_node = "{{ _k8s_cp_list[0] }}"
control_plane_replicas = {{ _k8s_cp_list | length }}
{% endif %}
k0s_version = "{{ spur_k8s_version }}"
{% endif %}

{% for h in groups['spur_agents'] %}
[[nodes]]
names = "{{ hostvars[h]['spur_node_name'] | default(h) }}"
cpus = {{ hostvars[h]['ansible_processor_vcpus'] | default(0) }}
memory_mb = {{ ((hostvars[h]['ansible_memtotal_mb'] | default(0)) * 0.9) | int }}
ansible_host = "{{ hostvars[h]['ansible_host'] | default(h) }}"

{% endfor %}
{% set _node_names = [] %}
{% for h in groups['spur_agents'] %}
{% set _ = _node_names.append(hostvars[h]['spur_node_name'] | default(h)) %}
{% endfor %}
[[partitions]]
name = "default"
default = true
nodes = "{{ _node_names | join(',') }}"
max_time = "INFINITE"
